---
import SiteLayout from '../../layouts/SiteLayout.astro';
const endpoint = 'https://mcp.otomasi.app/remote/mcp';
---
<SiteLayout title="Dashboard — Otomasi Remote MCP" description="Pantau status gateway Otomasi Remote MCP, endpoint, dan informasi server sirobo.">
  <section class="dashboard-page">
    <div class="container dashboard-grid">
      <aside class="dashboard-sidebar" aria-label="Menu dashboard">
        <div class="side-section-label">Workspace</div>
        <a class="sidebar-link active" href="/dashboard/"><span class="side-glyph">◫</span> Ringkasan</a>
        <a class="sidebar-link" href="#perangkat"><span class="side-glyph">▧</span> Perangkat</a>
        <a class="sidebar-link" href="#endpoint"><span class="side-glyph">⌘</span> Endpoint</a>
        <a class="sidebar-link" href="/connect/"><span class="side-glyph">✳</span> Hubungkan AI</a>
        <div class="sidebar-bottom"><div class="side-section-label">Otomasi</div><p>Dashboard ini memantau gateway MCP milik Anda. Tidak mengakses akun layanan hosted pihak ketiga.</p></div>
      </aside>
      <div class="dashboard-main">
        <div class="dashboard-heading">
          <div><span class="eyebrow">WORKSPACE / RINGKASAN</span><h1>Selamat datang di <span class="accent-text">Otomasi.</span></h1><p>Status langsung dari gateway yang berjalan pada server sirobo.</p></div>
          <button type="button" class="button button-light button-small" id="refresh-status">⟳ <span>Perbarui status</span></button>
        </div>
        <div class="dashboard-metrics">
          <div class="metric-card"><span class="metric-title">Status gateway <span>◉</span></span><div class="metric-value" id="metric-state" style="font-size:25px">Memeriksa…</div><div class="metric-note" id="metric-state-note">Menghubungi server</div></div>
          <div class="metric-card"><span class="metric-title">Sesi MCP aktif <span>⌘</span></span><div class="metric-value" id="metric-sessions">—</div><div class="metric-note">Jumlah sesi yang dilaporkan gateway</div></div>
          <div class="metric-card"><span class="metric-title">Host gateway <span>▧</span></span><div class="metric-value">sirobo</div><div class="metric-note">Server Linux Anda saat ini</div></div>
        </div>

        <section class="panel" id="perangkat">
          <div class="panel-header"><div><h2>Komputer host</h2><p>Mesin tempat engine MCP Otomasi dijalankan</p></div><span class="status-indicator" data-state="checking" id="device-status"><span class="status-dot"></span><span id="device-label">Memeriksa koneksi</span></span></div>
          <div class="panel-body">
            <div class="device-row"><span class="device-mark">▣</span><div class="device-description"><h3>sirobo</h3><p>Linux · Otomasi Remote MCP gateway</p></div><a href="/connect/" class="button button-light button-small">Hubungkan AI <span aria-hidden="true">↗</span></a></div>
            <div class="device-details"><div><span>Nama host</span><strong>sirobo</strong></div><div><span>Jenis koneksi</span><strong>Remote MCP melalui HTTPS</strong></div><div><span>Status pemeriksaan</span><strong id="last-checked">Belum diperiksa</strong></div></div>
          </div>
        </section>

        <section class="panel" id="endpoint">
          <div class="panel-header"><div><h2>Koneksi Remote MCP</h2><p>Alamat yang digunakan oleh asisten AI Anda</p></div><span class="status-indicator">OAuth 2.0 + PKCE</span></div>
          <div class="panel-body">
            <div class="code-title" style="margin-bottom:12px">Server URL</div>
            <div class="endpoint-box"><code id="mcp-url">{endpoint}</code><button type="button" class="button button-primary" data-copy={endpoint}>Salin URL</button></div>
            <div class="callout" style="margin-top:22px"><strong>Keamanan koneksi.</strong> Menambahkan URL ke klien AI tidak langsung memberikan akses komputer. Pengguna harus menyelesaikan otorisasi pemilik melalui OAuth.</div>
          </div>
        </section>

        <div class="action-cards">
          <article class="action-card"><h3>✳ Hubungkan asisten AI</h3><p>Langkah koneksi untuk klien yang mendukung Remote MCP, termasuk otorisasi awal.</p><a href="/connect/" class="text-link">Lihat panduan →</a></article>
          <article class="action-card"><h3>⌘ Periksa server</h3><p>Lihat respons pemeriksaan kesehatan yang disediakan oleh gateway MCP saat ini.</p><a href="/remote/healthz" class="text-link" target="_blank" rel="noopener noreferrer">Buka health endpoint ↗</a></article>
        </div>
        <section class="panel" style="margin-top:20px"><div class="panel-header"><div><h2>Tool engine MCP</h2><p>Contoh kemampuan yang tersedia pada core terpasang</p></div></div><div class="panel-body"><div class="tools-cloud"><span class="tool-chip">read_file</span><span class="tool-chip">write_file</span><span class="tool-chip">list_directory</span><span class="tool-chip">edit_block</span><span class="tool-chip">start_process</span><span class="tool-chip">read_process_output</span><span class="tool-chip">get_file_info</span><span class="tool-chip">start_search</span></div></div></section>
      </div>
    </div>
  </section>
  <script is:inline>
    (() => {
      const $ = id => document.getElementById(id);
      const button = $('refresh-status');
      const setStatus = (state, label) => {
        const indicator = $('device-status');
        indicator.dataset.state = state;
        $('device-label').textContent = label;
      };
      async function refresh() {
        button.disabled = true;
        button.querySelector('span').textContent = 'Memeriksa…';
        try {
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 7000);
          let response;
          try { response = await fetch('/remote/healthz', { cache: 'no-store', signal: controller.signal }); }
          finally { clearTimeout(timeout); }
          if (!response.ok) throw new Error('Gateway tidak merespons');
          const data = await response.json();
          if (data.status !== 'ok') throw new Error('Status belum tersedia');
          $('metric-state').textContent = 'Online';
          $('metric-state-note').textContent = 'Gateway dapat dijangkau';
          $('metric-sessions').textContent = Number.isSafeInteger(data.activeSessions) ? String(data.activeSessions) : '—';
          $('last-checked').textContent = new Intl.DateTimeFormat('id-ID',{hour:'2-digit',minute:'2-digit'}).format(new Date());
          setStatus('online','Terhubung');
        } catch {
          $('metric-state').textContent = 'Offline';
          $('metric-state-note').textContent = 'Gateway tidak dapat dijangkau';
          $('metric-sessions').textContent = '—';
          $('last-checked').textContent = 'Gagal terhubung';
          setStatus('offline','Tidak tersedia');
        } finally {
          button.disabled = false;
          button.querySelector('span').textContent = 'Perbarui status';
        }
      }
      button.addEventListener('click', refresh);
      document.querySelectorAll('[data-copy]').forEach(copyButton => copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyButton.dataset.copy || '');
          copyButton.textContent = 'Tersalin ✓';
        } catch {
          copyButton.textContent = 'Salin manual';
        }
      }));
      refresh();
    })();
  </script>
</SiteLayout>
