---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Halaman tidak ditemukan — Otomasi">
  <section class="page-intro" style="min-height:55vh;display:flex;align-items:center">
    <div class="container" style="text-align:center">
      <span class="eyebrow">HALAMAN TIDAK DITEMUKAN</span>
      <h1 style="font-size:clamp(75px,11vw,132px);color:var(--brown);margin:12px 0">404</h1>
      <p style="margin:0 auto 26px">Halaman yang Anda cari tidak tersedia. Silakan kembali ke beranda atau buka dashboard Otomasi.</p>
      <a href="/" class="button button-primary">Kembali ke beranda ↗</a>
    </div>
  </section>
</SiteLayout>
